{
  // Optional redirect worker. Configure CANONICAL_ORIGIN and your own route
  // before deployment; no upstream account or domain is targeted.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "paku-www-redirect",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "vars": { "CANONICAL_ORIGIN": "" }
}
